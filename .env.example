# 複製成 .env 後填入實際值(.env 已在 .gitignore 中)
# 部署到 Modal 時改用:
#   modal secret create job-finder-secrets OPENROUTER_API_KEY=... TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=...
# 變數名稱兩邊完全相同,程式碼不需要任何分支。

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Telegram — BotFather 建立 bot 後取得;chat id 從 getUpdates 取得
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# 緊急剎車:設為 1 / true 時,pipeline 直接短路不開瀏覽器(硬性規則 10)
JOBFINDER_SCRAPE_DISABLED=

# ─────────────────────────────────────────────────────────────────────
# 這裡「沒有」也「絕不會有」104 的帳號密碼欄位。
# 硬性規則 9:全程以匿名訪客身分抓取,絕不登入使用者的 104 帳號。
# 搜尋列表與職缺詳細頁對未登入訪客完全開放,登入沒有任何好處,
# 只會把自動化行為綁定到使用者的真實求職身分,風險遠高於 IP 被鎖。
# ─────────────────────────────────────────────────────────────────────
